# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/blue-sea-chat

# JWT
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_minimum_32_characters

# Server
PORT=5001
NODE_ENV=development

# Frontend URLs
FRONTEND_URL=http://localhost:3000

# Attachment storage.
# Render's disk is ephemeral - without these, uploaded media disappears on
# every restart/deploy. Leave unset locally to write to ./uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
