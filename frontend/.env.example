# Backend origin (no trailing slash - it would produce "//api/..." on every call)
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- WebRTC TURN relay -------------------------------------------------
# STUN alone only connects peers whose NAT can be punched through. Across
# mobile data / office wifi / symmetric NAT the call rings, both sides show
# "connected", and no audio or video ever arrives. A TURN server fixes that.
# Comma separated list of URLs.
NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
